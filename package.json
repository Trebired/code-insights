{
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "displayName": "Trebired",
      "name": "trebired",
      "website": "https://trebired.com"
    }
  },
  "name": "@trebired/code-insights",
  "version": "0.1.2",
  "description": "Fast repository insights for Bun apps: languages, file tree, file import graph, function call graph and hotspots, scanned by a native engine with live progress, plus an interactive code map for @trebired/frontend.",
  "type": "module",
  "private": false,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "files": [
    ".trebired/logger/config.ts",
    "dist",
    "native/linux-*/code-insights",
    "native/vendor/hyperpolyglot/LICENSE-MIT",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs",
    "build:native": "bun ./scripts/build/native.mjs",
    "prepare:generated": "bun node_modules/@trebired/code-discipline/dist/cli.js fix imports",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:pack && bun run verify:scan && bun run verify:map",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "verify:map": "bun ./scripts/verify/map.mjs",
    "verify:native": "cargo test --release --manifest-path native/code-insights/Cargo.toml",
    "verify:pack": "bun ./scripts/verify/pack.mjs",
    "verify:scan": "bun ./scripts/verify/scan.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.8.5",
    "d3-force": "^3.0.0"
  },
  "peerDependencies": {
    "@trebired/frontend": "^31.0.7",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@trebired/frontend": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@trebired/code-discipline": "^8.0.4",
    "@trebired/configs": "^0.11.1",
    "@trebired/frontend": "^31.0.7",
    "@types/bun": "^1.3.14",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "happy-dom": "^21.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "code-insights",
    "languages",
    "dependency-graph",
    "call-graph",
    "tree-sitter",
    "git",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/code-insights"
  },
  "homepage": "https://github.com/Trebired/code-insights#readme",
  "bugs": {
    "url": "https://github.com/Trebired/code-insights/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
